# =============================================================================
# LeggedGym-Ex — Docker Compose Environment Variables (SAMPLE)
# =============================================================================
# Copy this file to .env and edit the values for your machine:
#
#   cp .env.sample .env
#
# The .env file is git-ignored so local paths / secrets never leak into the
# repository.
# =============================================================================

# ---------------------------------------------------------------------------
# Genesis backend: "cpu" or "cuda"
# ---------------------------------------------------------------------------
# "cuda"  → tries GPU acceleration; falls back to CPU automatically if the
#           NVIDIA runtime is unavailable.
# "cpu"   → forces CPU-only mode (works on any machine, including Apple
#           Silicon and headless servers without a GPU).
# ---------------------------------------------------------------------------
GENESIS_BACKEND=cpu

# ---------------------------------------------------------------------------
# Active policy
# ---------------------------------------------------------------------------
# Must match a .pt filename (without extension) placed in ./policies/.
# If left blank, the first policy alphabetically is chosen automatically.
# ---------------------------------------------------------------------------
ACTIVE_POLICY=stable

# ---------------------------------------------------------------------------
# Network ports exposed to the host
# ---------------------------------------------------------------------------
# Change these only if the default ports are already in use.
#   CONTROL_PORT → FastAPI unified control web + WebSocket bridge
#   VISER_PORT   → viser 3-D web viewer
# ---------------------------------------------------------------------------
CONTROL_PORT=9013
VISER_PORT=9006

# ---------------------------------------------------------------------------
# Headless / smoke-test mode
# ---------------------------------------------------------------------------
# Set to 1 to disable the web viewer and run a short autonomous switch test
# instead.  Useful for CI or verifying that the container still imports and
# steps correctly after a code change.
# ---------------------------------------------------------------------------
HEADLESS=0

# ---------------------------------------------------------------------------
# Simulation playback speed
# ---------------------------------------------------------------------------
# Multiplier for the control loop.  1.0 = real-time (50 Hz).  Lower values
# slow the simulation so it is easier to follow on a slow machine.
# ---------------------------------------------------------------------------
SPEED=0.35
